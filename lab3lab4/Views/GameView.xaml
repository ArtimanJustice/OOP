<Window x:Class="ShadowMaiden.Views.GameView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ShadowMaiden.ViewModels"
        Title="Shadow Maiden"
        Background="#0d0d1a"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        ResizeMode="CanMinimize">

    <Window.DataContext>
        <vm:GameViewModel />
    </Window.DataContext>

    <Window.Resources>
        <vm:StringToBrushConverter x:Key="StringToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6060a0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#e8e0ff" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#505080" />
        </Style>

        <Style x:Key="HpBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#330000" CornerRadius="3"
                                    BorderBrush="#550000" BorderThickness="1" />
                            <Border x:Name="PART_Track" Background="Transparent" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="#CC2200"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFD700" />
            <Setter Property="Background" Value="#1e1e3a" />
            <Setter Property="BorderBrush" Value="#FFD700" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2e2e5a" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3e3e7a" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="SHADOW MAIDEN"
                       FontFamily="Consolas"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFD700"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10" />

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#0d0d1a">
                <ItemsControl ItemsSource="{Binding Cells}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding FieldWidth}"
                                         Rows="{Binding FieldHeight}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="28" Height="28"
                                    Background="{Binding Background, Converter={StaticResource StringToBrush}}"
                                    BorderBrush="#181828"
                                    BorderThickness="0.5">
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{Binding Foreground, Converter={StaticResource StringToBrush}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI Symbol" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#13132a" CornerRadius="4" Margin="0,8,0,0" Padding="12,6">
                <TextBlock Text="{Binding GameMessage}"
                           FontFamily="Consolas"
                           FontSize="13"
                           Foreground="#c0b8ff"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Border Grid.Column="1"
                Background="#13132a"
                CornerRadius="8"
                Margin="12,0,0,0"
                Padding="16,14">
            <StackPanel>

                <TextBlock Text="SHADOW"
                           FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                           Foreground="#FFD700" />
                <TextBlock Text="MAIDEN"
                           FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                           Foreground="#FFA500" Margin="0,-2,0,0" />

                <Rectangle Height="1" Fill="#2a2a4a" Margin="0,12,0,0" />

                <TextBlock Text="LEVEL" Style="{StaticResource StatLabel}" />
                <TextBlock Text="{Binding LevelDisplay}" Style="{StaticResource StatValue}" />

                <TextBlock Text="HP" Style="{StaticResource StatLabel}" />
                <ProgressBar Style="{StaticResource HpBar}"
                             Value="{Binding PlayerHp, Mode=OneWay}"
                             Maximum="{Binding PlayerMaxHp, Mode=OneWay}" />
                <TextBlock Style="{StaticResource HintText}">
                    <Run Text="{Binding PlayerHp, Mode=OneWay}" /><Run Text=" / " />
                    <Run Text="{Binding PlayerMaxHp, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Text="ATTACK" Style="{StaticResource StatLabel}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PlayerAttack}" Style="{StaticResource StatValue}" />
                    <TextBlock Text=" ⚔" FontFamily="Segoe UI Symbol" FontSize="16"
                               Foreground="#00BFFF" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                </StackPanel>

                <TextBlock Text="KEYS" Style="{StaticResource StatLabel}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PlayerKeys}" Style="{StaticResource StatValue}" />
                    <TextBlock Text=" ⚷" FontFamily="Segoe UI Symbol" FontSize="16"
                               Foreground="#FFD700" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                </StackPanel>

                <Rectangle Height="1" Fill="#2a2a4a" Margin="0,16,0,0" />

                <TextBlock Text="CONTROLS" Style="{StaticResource StatLabel}" Margin="0,12,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="WASD / ↑↓←→"
                               FontFamily="Consolas" FontSize="11" Foreground="#9090c0"
                               Margin="0,0,8,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="Move" Style="{StaticResource HintText}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="R"
                               FontFamily="Consolas" FontSize="11" Foreground="#9090c0"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="Restart" Style="{StaticResource HintText}" />
                </Grid>

                <Rectangle Height="1" Fill="#2a2a4a" Margin="0,16,0,12" />

                <TextBlock Text="LEGEND" Style="{StaticResource StatLabel}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="♀" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#FFD700" Width="20" />
                    <TextBlock Text="You" Style="{StaticResource HintText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#00FF88" Width="20" />
                    <TextBlock Text="Exit" Style="{StaticResource HintText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="▬" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#CD853F" Width="20" />
                    <TextBlock Text="Door" Style="{StaticResource HintText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="⚷" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#FFD700" Width="20" />
                    <TextBlock Text="Key" Style="{StaticResource HintText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="♥" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#FF69B4" Width="20" />
                    <TextBlock Text="Potion" Style="{StaticResource HintText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="☠" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#C0C0C0" Width="20" />
                    <TextBlock Text="Skeleton" Style="{StaticResource HintText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="▼" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#9370DB" Width="20" />
                    <TextBlock Text="Bat (flies)" Style="{StaticResource HintText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="◆" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#FF3333" Width="20" />
                    <TextBlock Text="Boss" Style="{StaticResource HintText}" />
                </StackPanel>

                <Rectangle Height="1" Fill="#2a2a4a" Margin="0,16,0,12" />

                <Button Content="RESTART"
                        Command="{Binding RestartCommand}"
                        Style="{StaticResource ActionButton}" />

                <Border Margin="0,10,0,0" CornerRadius="4" Padding="8,6"
                        Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVictory}" Value="True">
                                    <Setter Property="Background" Value="#003300" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVictory}" Value="False">
                                    <Setter Property="Background" Value="#330000" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVictory}" Value="True">
                                        <Setter Property="Text" Value="VICTORY!" />
                                        <Setter Property="Foreground" Value="#00FF88" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsVictory}" Value="False">
                                        <Setter Property="Text" Value="GAME OVER" />
                                        <Setter Property="Foreground" Value="#FF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>